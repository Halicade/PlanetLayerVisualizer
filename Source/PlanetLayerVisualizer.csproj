<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>PlanetLayerVisualizer</RootNamespace>
        <AssemblyName>PlanetLayerVisualizer</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <DebugType>embedded</DebugType>
        <OutputPath>..\1.7\Assemblies</OutputPath>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Lib.Harmony">
            <Version>3.0.0-rc.3</Version>
            <ExcludeAssets>runtime</ExcludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>..\..\..\Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Waylith">
            <HintPath>..\..\..\Waylith.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityStubs">
            <HintPath>..\..\..\UnityStubs.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="RimWorld">
            <HintPath>..\..\..\RimWorld.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
